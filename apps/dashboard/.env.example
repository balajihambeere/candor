# Base URL of Candor's FastAPI backend, reachable from wherever this
# dashboard runs (in Docker Compose: the "api" service name).
CANDOR_API_BASE_URL=http://localhost:8000

# One of the backend's API_KEYS (see ../.env.example) — server-side only,
# used to call write endpoints (disclose/reopen/resolve) on the dashboard
# user's behalf. Never sent to the browser.
CANDOR_API_KEY=dev-local-key

# Credentials for this dashboard's own login (separate from CANDOR_API_KEY:
# this gates a person, that gates a calling service). Change before
# deploying anywhere real.
DASHBOARD_USERNAME=ops
DASHBOARD_PASSWORD=change-me

# Secret used to sign the dashboard's session cookie. Generate a real one
# for anything beyond local dev, e.g.: openssl rand -hex 32
SESSION_SECRET=change-me-too
