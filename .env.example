# Postgres connection used by the API and Alembic migrations.
DATABASE_URL=postgresql+psycopg://candor:candor@db:5432/candor

# An LLM is used only by the Justify stage (turns a verified Decide/Trace
# record into a customer-facing sentence). Decide and Trace are deliberately
# deterministic and never call an LLM. Pick the provider with LLM_PROVIDER —
# only that provider's API key is required; the other section is unused.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_RETRIES=2

# Only used if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2

# Comma-separated API keys accepted by the write endpoints (this is a
# machine-to-machine decision service, not an end-user login system).
# The dashboard (apps/dashboard, a separate Next.js app) uses one of these
# as its own server-side CANDOR_API_KEY — see apps/dashboard/.env.example.
API_KEYS=dev-local-key

RATE_LIMIT_PER_MINUTE=120

LOG_LEVEL=INFO
